# Supabase Configuration
# Obtain these from your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default GPS Thresholds
DEFAULT_MAX_ACCURACY_METERS=100
DEFAULT_ATTENDANCE_RADIUS_METERS=50

# ==============================================================================
# Automatic Student Email Dispatch Configuration (Optional)
# ------------------------------------------------------------------------------
# The system supports both:
# 1) Direct 1-Click Dispatch via your local email app (Gmail / Outlook / Apple Mail) - Works out-of-the-box!
# 2) Automatic Server-Side Dispatch via Resend or SendGrid:
# ==============================================================================

# Option A: Resend (Recommended - https://resend.com)
# Free 3,000 emails/month, 100 emails/day:
# RESEND_API_KEY=re_1234567890abcdef
# EMAIL_FROM=Attendance System <onboarding@resend.dev>

# Option B: SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG.1234567890abcdef
# EMAIL_FROM=attendance@yourcollege.edu
